# Reference only. Never overwrite an existing private .env with this template.
# Hosted settings are generated by scripts/configure_azure.py and stored privately.
DEPLOYMENT_MODE=production
DATA_PLATFORM=azure
TEST_MODE=false
ENABLE_LOCAL_FIXTURES=false
ENABLE_PUBLIC_WEB_TOOLS=false
ALLOWED_ORIGINS=https://YOUR-APP.azurewebsites.net
AUTH_CLIENT_ID=YOUR-ENTRA-APPLICATION-GUID
AUTH_ALLOWED_TENANTS=YOUR-TENANT-GUID
AUTH_OPERATOR_IDS=YOUR-OPERATOR-OBJECT-GUID

AZURE_USE_ENTRA_ID=true
GENERATION_PROVIDER=azure_openai
EMBED_PROVIDER=azure_openai
AZURE_FOUNDRY_ENDPOINT=https://YOUR-FOUNDRY.openai.azure.com
AZURE_MODEL_DEPLOYMENT=deskmate-reasoning
AZURE_EMBEDDING_DEPLOYMENT=deskmate-embedding
AZURE_EMBEDDING_DIMENSIONS=384
AZURE_REASONING_MIN_INTERVAL_SECONDS=12
AZURE_EMBEDDING_MIN_INTERVAL_SECONDS=10

AZURE_COSMOS_ENDPOINT=https://YOUR-ACCOUNT.documents.azure.com
AZURE_COSMOS_DATABASE=deskmate
AZURE_COSMOS_CONTAINER=state
AZURE_STORAGE_ACCOUNT_URL=https://YOUR-STORAGE.blob.core.windows.net
AZURE_STORAGE_CONTAINER=documents
AZURE_SEARCH_ENDPOINT=https://YOUR-SEARCH.search.windows.net
AZURE_SEARCH_INDEX=knowledge
AZURE_SEARCH_SEMANTIC_ENABLED=true
AZURE_DOCUMENT_ENDPOINT=https://YOUR-DOCUMENT-RESOURCE.cognitiveservices.azure.com
AZURE_DOCUMENT_API_VERSION=2024-11-30
AZURE_DOCUMENT_FREE_TIER=true
AZURE_DOCUMENT_MONTHLY_PAGE_LIMIT=500
AZURE_KEY_VAULT_URL=https://YOUR-VAULT.vault.azure.net

# On App Service, use a Key Vault reference. Startup rejects unresolved references.
VOICE_SESSION_SIGNING_KEY=@Microsoft.KeyVault(SecretUri=https://YOUR-VAULT.vault.azure.net/secrets/deskmate-session-signing-key/)
VOICE_AUTH_MODE=entra
VOICE_AUTH_TENANT_ID=YOUR-TENANT-GUID
VOICE_AUTH_AUDIENCE=YOUR-ENTRA-APPLICATION-GUID
VOICE_TENANT_ID=YOUR-TENANT-GUID
VOICE_PROVIDER=azure_voicelive
VOICE_ENABLED=true
AZURE_VOICELIVE_ENDPOINT=https://YOUR-FOUNDRY.services.ai.azure.com
AZURE_VOICELIVE_MODEL=gpt-realtime
AZURE_VOICELIVE_API_VERSION=2026-04-10

# These remain binding. Separate explicit authorization is required for enablement.
AZURE_USAGE_GUARD_ENABLED=true
AZURE_EMERGENCY_DISABLE=true
AZURE_ESTIMATED_MONTHLY_APP_LIMIT_CAD=8
AZURE_ESTIMATED_SETUP_LIMIT_CAD=2
AZURE_MAX_CONCURRENT_SESSIONS=1
AZURE_MAX_LIVE_SESSIONS_PER_DAY=2
AZURE_MAX_VOICE_SESSION_MINUTES=10
AZURE_MAX_TURNS_PER_SESSION=20
ALLOW_URL_INGEST=false
