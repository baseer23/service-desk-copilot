# Optional Azure AI processing on the same local persistent Mac profile.
# Start from .env.example; this is an overlay for review, not a deploy command.
# No Cosmos, Blob, Search, cloud database or Voice Live endpoint is used.
GENERATION_PROVIDER=azure_openai
GROQ_API_KEY=
GROQ_MODEL_NAME=openai/gpt-oss-120b
AZURE_USE_ENTRA_ID=true
AZURE_FOUNDRY_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
AZURE_MODEL_DEPLOYMENT=YOUR-EXISTING-DEPLOYMENT
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_STRUCTURED_OUTPUTS=true
EMBED_PROVIDER=sentence_transformers
EMBED_MODEL_NAME=all-MiniLM-L6-v2
DATA_PLATFORM=local
LOCAL_PERSISTENCE_ENABLED=true
CHROMA_DIR=store/local/chroma
CASE_DB_PATH=store/local/state.sqlite3
LOCAL_DOCUMENTS_DIR=store/local/documents
AZURE_DOCUMENT_ENDPOINT=https://YOUR-DOCUMENT-RESOURCE.cognitiveservices.azure.com
AZURE_DOCUMENT_API_VERSION=2024-11-30
AZURE_DOCUMENT_FREE_TIER=true
AZURE_DOCUMENT_MONTHLY_PAGE_LIMIT=500
SPEECH_ENABLED=false
AZURE_SPEECH_ENDPOINT=https://YOUR-SPEECH-RESOURCE.cognitiveservices.azure.com/
AZURE_SPEECH_LANGUAGE=en-US
AZURE_SPEECH_ESTIMATED_CAD_PER_HOUR=2.0
SPEECH_MAX_CONCURRENT_SESSIONS=1
VOICE_SESSION_SIGNING_KEY=
VOICE_TENANT_ID=local-demo
VOICE_AUTH_MODE=local_demo
AZURE_USAGE_GUARD_ENABLED=false
AZURE_EMERGENCY_DISABLE=true
AZURE_ESTIMATED_MONTHLY_APP_LIMIT_CAD=8
AZURE_ESTIMATED_SETUP_LIMIT_CAD=2
ENABLE_LOCAL_FIXTURES=false
ENABLE_PUBLIC_WEB_TOOLS=false
ALLOW_URL_INGEST=false
