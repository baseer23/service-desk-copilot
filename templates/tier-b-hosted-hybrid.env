# Azure application host: inject credentials/identity settings through the platform.
GENERATION_PROVIDER=azure_openai
EMBED_PROVIDER=azure_openai
TEST_MODE=false
DEPLOYMENT_MODE=production
AZURE_USE_ENTRA_ID=true
# Azure OpenAI resource origin, never a project or Voice Live endpoint.
AZURE_FOUNDRY_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
AZURE_MODEL_DEPLOYMENT=deskmate-reasoning
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_EMBEDDING_DEPLOYMENT=deskmate-embedding
EMBED_MODEL_NAME=text-embedding-3-small
AZURE_EMBEDDING_DIMENSIONS=384
VOICE_ENABLED=false
VOICE_PROVIDER=azure_voicelive
AZURE_VOICELIVE_ENDPOINT=https://YOUR-RESOURCE.services.ai.azure.com
AZURE_VOICELIVE_MODEL=gpt-realtime
AZURE_VOICELIVE_API_VERSION=2026-04-10
AZURE_VOICELIVE_VOICE=en-US-AvaNeural
VOICE_AUTH_MODE=entra
VOICE_AUTH_TENANT_ID=
VOICE_AUTH_AUDIENCE=
VOICE_SESSION_SIGNING_KEY=
VOICE_TENANT_ID=
ALLOWED_ORIGINS=https://YOUR-APP-HOST
CHROMA_DIR=store/chroma
CASE_DB_PATH=store/case_memory.db
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=
ALLOW_URL_INGEST=true
KNOWLEDGE_SCOPE=support
RESEARCH_SOURCE_POLICY=prefer_primary
