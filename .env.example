# DeskMate: local persistence and embeddings, optional cloud intelligence/STT.
# Review this template; never overwrite an existing private .env.
GENERATION_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL_NAME=openai/gpt-oss-120b
# 0 selects DeskMate's documented model limit; set only for a verified custom deployment.
GROQ_CONTEXT_WINDOW_TOKENS=0
GROQ_MAX_OUTPUT_TOKENS=1500
GROQ_MAX_RETRIES=2
GROQ_QUEUE_TIMEOUT_SEC=120
GROQ_MAX_CONCURRENT_REQUESTS=1
# Enter exact current account/model limits from Groq's Limits page if known.
# 0 means unknown. Live response headers establish daily requests and minute tokens.
GROQ_REQUESTS_PER_MINUTE=0
GROQ_REQUESTS_PER_DAY=0
GROQ_TOKENS_PER_MINUTE=0
GROQ_TOKENS_PER_DAY=0
# Disabled by default. When enabled, only a recoverable Groq failure may switch
# once to configured Azure OpenAI, with a visible timeline event.
PROVIDER_FALLBACK_ENABLED=false
# Optional account-specific CAD prices; blank stays unknown, never assumed free.
# GROQ_INPUT_CAD_PER_MILLION=
# GROQ_OUTPUT_CAD_PER_MILLION=
MODEL_TIMEOUT_SEC=30

TEST_MODE=false
DEPLOYMENT_MODE=local
DATA_PLATFORM=local
LOCAL_PERSISTENCE_ENABLED=true
LOCAL_DOCUMENTS_DIR=store/local/documents
CHROMA_DIR=store/local/chroma
CASE_DB_PATH=store/local/state.sqlite3
EMBED_PROVIDER=sentence_transformers
EMBED_MODEL_NAME=all-MiniLM-L6-v2
TOP_K=6
CHUNK_TOKENS=512
CHUNK_OVERLAP=64
# Optional real Aura. Missing/unreachable Aura retains vector-only investigations.
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
NEO4J_INGESTION_ENABLED=false
NEO4J_INGESTION_USER=
NEO4J_INGESTION_PASSWORD=
# references (default): exact document values stay local. structured_values: also
# store selected options, option labels and table cell values in Neo4j (authorize first).
GRAPH_CONTENT_POLICY=references

# Explicitly selected Azure OpenAI inference only; no Azure persistence.
AZURE_FOUNDRY_ENDPOINT=
AZURE_MODEL_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_USE_ENTRA_ID=true
AZURE_OPENAI_API_KEY=
AZURE_STRUCTURED_OUTPUTS=true
# Optional Azure Document Intelligence extraction; original files stay local.
AZURE_DOCUMENT_ENDPOINT=
AZURE_DOCUMENT_API_VERSION=2024-11-30
AZURE_DOCUMENT_FREE_TIER=true
# Explicit paid-operation opt-in. Requires the separate Neo4j writer above.
AUTO_DOCUMENT_GRAPH_INGESTION=false

# Continuous Speech-to-Text only. No TTS, Voice Live or realtime audio-model calls.
SPEECH_ENABLED=false
AZURE_SPEECH_ENDPOINT=
AZURE_SPEECH_LANGUAGE=en-US
SPEECH_MAX_CONCURRENT_SESSIONS=1
# Existing identity keys retain their names to preserve cookie/history ownership.
VOICE_SESSION_SIGNING_KEY=
VOICE_TENANT_ID=local-demo
VOICE_AUTH_MODE=local_demo
VOICE_AUTH_TENANT_ID=
VOICE_AUTH_AUDIENCE=
AUTH_CLIENT_ID=
AUTH_ALLOWED_TENANTS=
AUTH_OPERATOR_IDS=
AZURE_KEY_VAULT_URL=
AZURE_SESSION_SECRET_NAME=deskmate-session-signing-key

# Explicit allowlisted MCP servers; never put credentials in tool arguments.
# Official Neo4j MCP example (macOS Homebrew); credentials come from the
# validated NEO4J_* settings above and are never stored in this JSON.
# MCP_SERVERS=[{"name":"neo4j","transport":"stdio","command":"/opt/homebrew/bin/neo4j-mcp","args":[],"environment":{},"read_tools":["get-schema","read-cypher"],"workflows":["knowledge","service_desk"],"allowed_tenants":[]}]
MCP_SERVERS=[]
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
ENABLE_LOCAL_FIXTURES=false
ENABLE_PUBLIC_WEB_TOOLS=false
ALLOW_URL_INGEST=false
URL_MAX_DEPTH=1
URL_MAX_PAGES=5
URL_MAX_TOTAL_CHARS=20000
URL_RATE_LIMIT_SEC=1
URL_CRAWLER_CONTACT=
URL_AZURE_ANALYSIS=false
WEB_MAX_BYTES=2000000
MAX_INVESTIGATION_CYCLES=8
MAX_RESEARCH_ROUNDS=1
KNOWLEDGE_SCOPE=support
RESEARCH_SOURCE_POLICY=prefer_primary
RESEARCH_PREFERRED_DOMAINS=learn.microsoft.com,support.microsoft.com,docs.aws.amazon.com,support.google.com,nist.gov,cisa.gov

AZURE_MAX_INPUT_TOKENS=32768
AZURE_MAX_OUTPUT_TOKENS=1500
AZURE_REASONING_MIN_INTERVAL_SECONDS=0
