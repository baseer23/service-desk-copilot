# Azure-only live runtime. Preserve an existing .env; migrate its values deliberately.
GENERATION_PROVIDER=azure_openai
EMBED_PROVIDER=azure_openai
TEST_MODE=false
DEPLOYMENT_MODE=local
# Azure OpenAI resource origin: https://RESOURCE.openai.azure.com
# Despite the variable name, never enter a Foundry project URL or Voice Live URL.
AZURE_FOUNDRY_ENDPOINT=
AZURE_MODEL_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_USE_ENTRA_ID=true
# Optional only with AZURE_USE_ENTRA_ID=false in local development.
AZURE_OPENAI_API_KEY=
AZURE_STRUCTURED_OUTPUTS=true
AZURE_EMBEDDING_DEPLOYMENT=
EMBED_MODEL_NAME=text-embedding-3-small
AZURE_EMBEDDING_DIMENSIONS=384
MODEL_TIMEOUT_SEC=30

# Browser Azure Voice Live, disabled until configured.
VOICE_ENABLED=false
VOICE_PROVIDER=azure_voicelive
AZURE_VOICELIVE_ENDPOINT=
AZURE_VOICELIVE_MODEL=gpt-realtime
AZURE_VOICELIVE_API_VERSION=2026-04-10
AZURE_VOICELIVE_VOICE=en-US-AvaNeural
AZURE_VOICELIVE_API_KEY=
VOICE_TENANT_ID=local-demo
VOICE_AUTH_MODE=local_demo
# Set a stable random secret of at least 32 characters for identity across restart.
# Otherwise a process-only random signing key is generated. Never use VITE_* for secrets.
VOICE_SESSION_SIGNING_KEY=
# Required for deployed Entra bearer-token exchange.
VOICE_AUTH_TENANT_ID=
VOICE_AUTH_AUDIENCE=
VOICE_SESSION_TIMEOUT_SEC=900
VOICE_MAX_TURNS=1000
VOICE_MAX_CONFIRMATION_RETRIES=3
VOICE_TRANSCRIPT_RETENTION_HOURS=24
CHROMA_DIR=store/chroma
CASE_DB_PATH=store/case_memory.db
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
ALLOW_URL_INGEST=true
URL_MAX_DEPTH=1
URL_MAX_PAGES=5
URL_MAX_TOTAL_CHARS=20000
URL_RATE_LIMIT_SEC=1
WEB_MAX_BYTES=2000000
TOP_K=6
CHUNK_TOKENS=512
CHUNK_OVERLAP=64
MAX_INVESTIGATION_CYCLES=8
MAX_RESEARCH_ROUNDS=2
# Default scope accepts IT support, internal knowledge and uploaded documents.
KNOWLEDGE_SCOPE=support
# prefer_primary | primary_only | allow_third_party
RESEARCH_SOURCE_POLICY=prefer_primary
RESEARCH_PREFERRED_DOMAINS=learn.microsoft.com,support.microsoft.com,docs.aws.amazon.com,support.google.com,support.apple.com,developer.mozilla.org,cisco.com,fortinet.com,watchguard.com,okta.com,canada.ca,gov.uk,nist.gov,cisa.gov

# Local estimated usage guard. Azure requests require explicit enablement.
# This is NOT a subscription billing cap. Keep false until approved testing.
AZURE_USAGE_GUARD_ENABLED=false
AZURE_LIVE_TEST_MODE=true
AZURE_ESTIMATED_MONTHLY_APP_LIMIT_CAD=8.00
# Empty derives a separate ledger next to CASE_DB_PATH. Use fresh private paths.
AZURE_USAGE_DB_PATH=
AZURE_MAX_CONCURRENT_SESSIONS=1
AZURE_MAX_VOICE_SESSION_MINUTES=10
AZURE_MAX_TURNS_PER_SESSION=20
AZURE_MAX_LIVE_SESSIONS_PER_DAY=2
AZURE_MAX_INPUT_TOKENS=32768
AZURE_MAX_OUTPUT_TOKENS=1500
# Conservative local CAD assumptions; NOT published Azure prices or an FX quote.
AZURE_ESTIMATED_INPUT_CAD_PER_MILLION=10
AZURE_ESTIMATED_OUTPUT_CAD_PER_MILLION=40
AZURE_ESTIMATED_EMBEDDING_CAD_PER_MILLION=1
AZURE_ESTIMATED_VOICE_CAD_PER_MINUTE=0.50
AZURE_EMERGENCY_DISABLE=false
# Separate setup allowance; enable only for authorized activation validation.
AZURE_SETUP_VALIDATION_MODE=false
AZURE_ESTIMATED_SETUP_LIMIT_CAD=2.00
AZURE_SETUP_MAX_VOICE_SECONDS=60
# Match provisioned throughput without retrying failed requests.
AZURE_REASONING_MIN_INTERVAL_SECONDS=0
AZURE_EMBEDDING_MIN_INTERVAL_SECONDS=0
